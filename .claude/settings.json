{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(cd backend && poetry run pytest *)",
      "Bash(cd backend && poetry run alembic *)",
      "Bash(cd backend && poetry run ruff *)",
      "Bash(cd backend && poetry run mypy *)",
      "Bash(cd frontend && pnpm *)",
      "Bash(make *)",
      "Bash(docker-compose *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(poetry *)",
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(ls *)",
      "Bash(wc *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/branch-guard.sh"
          }
        ]
      }
    ]
  }
}
