# Backend Environment Variables — COPY TO .env AND FILL IN VALUES
# DO NOT commit .env to git

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Database (SQLAlchemy async format) ───────────────────────────────────────
# Use Supabase connection pooler (Transaction mode) for production
# Format: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/auto_apply

# ── Redis / Queue ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Job Data ─────────────────────────────────────────────────────────────────
ADZUNA_APP_ID=your_app_id
ADZUNA_API_KEY=your_api_key

# Fantastic Jobs API (primary source via RapidAPI)
RAPIDAPI_KEY=your_rapidapi_key_here

# ── Payments (Stripe) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (get these from Stripe Dashboard after creating products)
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_PREMIUM_PRICE_ID=price_...

# ── Internal Auth (for agent worker → platform calls) ────────────────────────
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=generate_a_secure_random_key_here

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...

# ── App Config ────────────────────────────────────────────────────────────────
ENV=development
# ENV options: development | staging | production

ALLOWED_ORIGINS=http://localhost:3000
# Production: ALLOWED_ORIGINS=https://yourdomain.com

LOG_LEVEL=INFO
# LOG_LEVEL options: DEBUG | INFO | WARNING | ERROR
